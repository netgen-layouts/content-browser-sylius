{% import "@SyliusShop/shared/macro/money.html.twig" as money %}

<p>{{ item.product.name }}</p>

<p>{{ include('@SyliusShop/shared/components/main_image.html.twig', { 'product': item.product }) }}</p>

{% if not item.product.variants.empty %}
    <p>{{ money.calculatePrice(item.product|sylius_resolve_variant) }}</p>
{% endif %}
